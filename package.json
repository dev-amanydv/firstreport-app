{
  "name": "firstreport",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:generate": "pnpm --filter @fr/db generate",
    "db:migrate": "pnpm --filter @fr/db migrate",
    "db:seed": "pnpm --filter @fr/db seed",
    "db:studio": "pnpm --filter @fr/db studio",
    "worker:tick": "pnpm --filter @fr/worker tick",
    "worker:start": "pnpm --filter @fr/worker start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "label:pairs": "pnpm --filter @fr/worker label:pairs",
    "label:report": "pnpm --filter @fr/worker label:report",
    "events:reset": "pnpm --filter @fr/worker events:reset",
    "cards:report": "pnpm --filter @fr/worker cards:report",
    "worker:nightly": "pnpm --filter @fr/worker nightly",
    "api:start": "pnpm --filter @fr/api start",
    "mobile": "pnpm --filter @fr/mobile start"
  }
}
