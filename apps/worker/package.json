{
  "name": "@fr/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "tick": "tsx --env-file-if-exists=../../.env src/cli/tick.ts",
    "start": "tsx --env-file-if-exists=../../.env src/start.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "label:pairs": "tsx --env-file-if-exists=../../.env src/cli/labelPairs.ts",
    "label:report": "tsx src/cli/labelReport.ts",
    "events:reset": "tsx --env-file-if-exists=../../.env src/cli/resetEvents.ts",
    "cards:report": "tsx --env-file-if-exists=../../.env src/cli/cardReport.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fr/db": "workspace:*",
    "@fr/shared": "workspace:*",
    "@google/genai": "^2.30.0",
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^30.1.3",
    "pg-boss": "^12.38.0",
    "robots-parser": "^3.0.1",
    "rss-parser": "^3.13.0"
  }
}
