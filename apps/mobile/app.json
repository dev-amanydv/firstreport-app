{
  "expo": {
    "name": "FirstReport",
    "slug": "firstreport",
    "scheme": "firstreport",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#E6E6E6",
    "android": {
      "package": "in.firstreport.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png",
        "backgroundColor": "#FAF8F4"
      }
    },
    "ios": {
      "bundleIdentifier": "in.firstreport.app",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 260,
          "backgroundColor": "#E6E6E6",
          "dark": {
            "image": "./assets/images/splash-logo-dark.png",
            "backgroundColor": "#0B0B0B"
          },
          "android": {
            "imageWidth": 184
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-sharing",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_ME"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
