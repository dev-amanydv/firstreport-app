# Copy to apps/mobile/.env. Expo inlines EXPO_PUBLIC_* values into the app at build time: no secrets here.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# The Google OAuth *web* client ID (the same value as GOOGLE_WEB_CLIENT_ID in the root .env).
# REPLACE_ME keeps sign-in off: the button then says sign-in isn't set up yet.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_ME
